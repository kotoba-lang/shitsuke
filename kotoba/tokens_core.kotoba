(ns tokens-core
  ;; No :export: parity harness appends zero-arg case defns via KIR.
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :tok/css-var-name [:record :tok/css-var-name
                                [[:group :string] [:k :string]]]
             :tok/decl [:record :tok/decl
                        [[:name :string] [:value :string]]]
             :tok/scalar-decl [:record :tok/scalar-decl
                               [[:group :string] [:k :string] [:value :string]]]
             :tok/nested-decl [:record :tok/nested-decl
                               [[:group :string] [:k :string]
                                [:prop :string] [:value :string]]]
             :tok/group-from [:record :tok/group-from
                              [[:group :string]
                               [:decls [:map :keyword :string]]
                               [:index :i64]
                               [:acc :string]]]
             :tok/group-css [:record :tok/group-css
                             [[:group :string]
                              [:decls [:map :keyword :string]]]]}))

;; A `.kotoba` port of the string-producing core of `shitsuke.tokens`
;; (ADR-2607270100 §10, form A). No capabilities: token → CSS custom
;; properties is data → text, so this module sits in kotoba/pure.
;;
;; Recursive token maps and deep-merge stay on the .cljc side. This port
;; receives already-resolved (group, name, value) strings / flat
;; `[:map :keyword :string]` groups and composes the same `--shitsuke-*`
;; declaration lines `shitsuke.tokens` emits. Nested type entries are
;; modelled as dotted prop suffixes (`--shitsuke-type-title-font-size`)
;; rather than recursive maps (Kotoba has no recursive value types).
;;
;; Map walks use `typed-map-entry-at` (sorted by key). Parity is asserted
;; against key-sorted runs of the .cljc original, same finding as css/html.
;; T5.2: multi-arg pure folded into single guest records.

;; --- names ----------------------------------------------------------------

(defn css-var-name [x [:ref :tok/css-var-name]] :string
  (let [group (record-get x :group)
        k (record-get x :k)]
    (string-concat "--shitsuke-"
                   (string-concat group
                                  (string-concat "-" k)))))

(defn decl [x [:ref :tok/decl]] :string
  (let [name (record-get x :name)
        value (record-get x :value)]
    (string-concat "  "
                   (string-concat name
                                  (string-concat ": "
                                                 (string-concat value ";"))))))

(defn scalar-decl [x [:ref :tok/scalar-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        value (record-get x :value)]
    (decl (record-new [:ref :tok/decl]
                      (css-var-name (record-new [:ref :tok/css-var-name] group k))
                      value))))

(defn nested-decl [x [:ref :tok/nested-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        prop (record-get x :prop)
        value (record-get x :value)]
    (decl (record-new [:ref :tok/decl]
                      (string-concat (css-var-name (record-new [:ref :tok/css-var-name] group k))
                                     (string-concat "-" prop))
                      value))))

;; --- flat group emission --------------------------------------------------
;; A group of scalar string values (colors, spacing, breakpoints).

(defn group-from [x [:ref :tok/group-from]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)
        index (record-get x :index)
        acc (record-get x :acc)]
    (match-option (typed-map-entry-at [:map :keyword :string] decls index)
                  [:option [:vector [:keyword :string]]]
                  (none acc)
                  (some entry
                        (group-from
                         (record-new [:ref :tok/group-from]
                                     group decls (+ index 1)
                                     (if (string=? acc "")
                                       (scalar-decl
                                        (record-new [:ref :tok/scalar-decl]
                                                    group
                                                    (keyword-name
                                                     (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                    (hetero-vector-at [:vector [:keyword :string]] entry 1)))
                                       (string-concat acc
                                                      (string-concat "\n"
                                                                     (scalar-decl
                                                                      (record-new [:ref :tok/scalar-decl]
                                                                                  group
                                                                                  (keyword-name
                                                                                   (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                                  (hetero-vector-at [:vector [:keyword :string]] entry 1))))))))))))

(defn group-css [x [:ref :tok/group-css]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)]
    (group-from (record-new [:ref :tok/group-from] group decls 0 ""))))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

;; --- normalize-hex --------------------------------------------------------
;; slides.design hex WITHOUT leading # → CSS needs #. Pass through if already
;; hashed. Code point 35 is '#'.

(defn normalize-hex [s :string] :string
  (if (= (string-code-point-at s 0) 35)
    s
    (string-concat "#" s)))

;; --- default color / spacing corpus (call-graph defaults) -----------------
;; Mirrors shitsuke.tokens/default-tokens scalar groups. Composition order is
;; key-sorted so the emitted text is deterministic.

(defn default-colors [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :accent "#496B9A"
                 :accent2 "#7C9A4B"
                 :danger "#B46A55"
                 :ink "#17202A"
                 :line "#D8DEE8"
                 :muted "#526170"
                 :panel "#F7F8FB"
                 :wash "#FFFFFF"))

(defn default-spacing [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :0 "0px" :1 "4px" :2 "8px" :3 "12px"
                 :4 "16px" :5 "24px" :6 "32px"))

(defn default-breakpoints [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :lg "1200px" :md "940px" :sm "640px"))

(defn default-scalar-root [] :string
  (root-css
   (string-concat
    (group-css (record-new [:ref :tok/group-css] "colors" (default-colors)))
    (string-concat "\n"
                   (string-concat
                    (group-css (record-new [:ref :tok/group-css] "spacing" (default-spacing)))
                    (string-concat "\n"
                                   (group-css (record-new [:ref :tok/group-css]
                                                          "breakpoints"
                                                          (default-breakpoints)))))))))

(defn main []
  (string-byte-length (default-scalar-root)))
