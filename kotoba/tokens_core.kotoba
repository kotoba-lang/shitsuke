(ns tokens-core)

;; A `.kotoba` port of the string-producing core of `shitsuke.tokens`
;; (ADR-2607270100 §10, form A). No capabilities: token → CSS custom
;; properties is data → text, so this module sits in kotoba/pure.
;;
;; Recursive token maps and deep-merge stay on the .cljc side. This port
;; receives already-resolved (group, name, value) strings / flat
;; `[:map :keyword :string]` groups and composes the same `--shitsuke-*`
;; declaration lines `shitsuke.tokens` emits. Nested type entries are
;; modelled as dotted prop suffixes (`--shitsuke-type-title-font-size`)
;; rather than recursive maps (Kotoba has no recursive value types).
;;
;; Map walks use `typed-map-entry-at` (sorted by key). Parity is asserted
;; against key-sorted runs of the .cljc original, same finding as css/html.

;; --- names ----------------------------------------------------------------

(defn css-var-name [group :string k :string] :string
  (string-concat "--shitsuke-"
                 (string-concat group
                                (string-concat "-" k))))

(defn decl [name :string value :string] :string
  (string-concat "  "
                 (string-concat name
                                (string-concat ": "
                                               (string-concat value ";")))))

(defn scalar-decl [group :string k :string value :string] :string
  (decl (css-var-name group k) value))

(defn nested-decl [group :string k :string prop :string value :string] :string
  (decl (string-concat (css-var-name group k)
                       (string-concat "-" prop))
        value))

;; --- flat group emission --------------------------------------------------
;; A group of scalar string values (colors, spacing, breakpoints).

(defn group-from [group :string decls [:map :keyword :string] index :i64 acc :string]
  :string
  (match-option (typed-map-entry-at [:map :keyword :string] decls index)
                [:option [:vector [:keyword :string]]]
                (none acc)
                (some entry
                      (group-from group decls (+ index 1)
                                  (if (string=? acc "")
                                    (scalar-decl group
                                                 (keyword-name
                                                  (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                 (hetero-vector-at [:vector [:keyword :string]] entry 1))
                                    (string-concat acc
                                                   (string-concat "\n"
                                                                  (scalar-decl group
                                                                               (keyword-name
                                                                                (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                               (hetero-vector-at [:vector [:keyword :string]] entry 1)))))))))

(defn group-css [group :string decls [:map :keyword :string]] :string
  (group-from group decls 0 ""))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

;; --- normalize-hex --------------------------------------------------------
;; slides.design hex WITHOUT leading # → CSS needs #. Pass through if already
;; hashed. Code point 35 is '#'.

(defn normalize-hex [s :string] :string
  (if (= (string-code-point-at s 0) 35)
    s
    (string-concat "#" s)))

;; --- default color / spacing corpus (call-graph defaults) -----------------
;; Mirrors shitsuke.tokens/default-tokens scalar groups. Composition order is
;; key-sorted so the emitted text is deterministic.

(defn default-colors [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :accent "#496B9A"
                 :accent2 "#7C9A4B"
                 :danger "#B46A55"
                 :ink "#17202A"
                 :line "#D8DEE8"
                 :muted "#526170"
                 :panel "#F7F8FB"
                 :wash "#FFFFFF"))

(defn default-spacing [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :0 "0px" :1 "4px" :2 "8px" :3 "12px"
                 :4 "16px" :5 "24px" :6 "32px"))

(defn default-breakpoints [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :lg "1200px" :md "940px" :sm "640px"))

(defn default-scalar-root [] :string
  (root-css
   (string-concat
    (group-css "colors" (default-colors))
    (string-concat "\n"
                   (string-concat
                    (group-css "spacing" (default-spacing))
                    (string-concat "\n"
                                   (group-css "breakpoints" (default-breakpoints))))))))

(defn main []
  (string-byte-length (default-scalar-root)))
