(ns style-core
  ;; No :export: the parity harness appends zero-arg case defns via KIR.
  (:schemas {:sty/inline [:record :sty/inline [[:css :string]]]}))

;; A `.kotoba` port of the string-producing core of `shitsuke.style`
;; (ADR-2607270100 §10, form A; css -> html -> **shitsuke**). Token -> CSS
;; text is data -> text, so this module sits in kotoba/pure: no capabilities.
;;
;; `shitsuke.style` has four public fns. Two of them are decisions this port
;; owns:
;;
;;   class-name      the `shitsuke__<component>` scoped-class convention that
;;                   both the hiccup :class and the shadow-css extraction
;;                   anchor depend on
;;   inline-style    the <style> wrapper shape used for inline SSR embedding
;;
;; The other two stay host-side and are NOT gaps in this port:
;;
;;   root-css              pure delegation to shitsuke.tokens, whose core is
;;                         already ported (kotoba/tokens_core.kotoba)
;;   inline-style-hiccup   returns a hiccup vector, i.e. a logical value, so
;;                         it belongs to the document plane (a later
;;                         style_document.kotoba slice), not to form A
;;
;; `class-name` takes the component as a `:string`; the host keeps the
;; `(name component)` keyword coercion, same boundary the tokens/hig ports
;; draw (keywords are carried as values, not operated on).

(defn class-name [component :string] :string
  (string-concat "shitsuke__" component))

(defn inline-style [x [:ref :sty/inline]] :string
  (let [css (record-get x :css)]
    (string-concat "<style>\n"
                   (string-concat css "\n</style>"))))

;; Entry point: the module is a library, so `main` exists only to satisfy the
;; compiler's entryless-library rule (same convention as tokens_core/hig_core).
(defn main []
  (string-byte-length (inline-style (record-new [:ref :sty/inline] ""))))
