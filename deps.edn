{:paths ["src" "resources"]
 ;; Runtime deps: kotoba-lang/html (html.core) — shitsuke.hiccup delegates its
 ;; tag/attr/style primitives and RAWTEXT (script/style) breakout-guard to the
 ;; standalone substrate repo instead of duplicating them (html.core was
 ;; extracted FROM this namespace; this closes the loop so fixes land once).
 ;; Everything else is still zero third-party runtime deps — every namespace
 ;; is portable .cljc (JVM, CLJS, SCI, babashka). real reagent/re-frame/
 ;; shadow-css are build/dev aliases only (consumer picks the host impl via
 ;; the re-frame.core / reagent.core compat shims). Same split as
 ;; kami-mangaka-reader-clj + slides.
 :deps {io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html.git"
         ;; inferred option fallback in the document renderer
         :git/sha "23566059c5b25efd2a91030d5b19b98f50756b01"}
        ;; The KIR interpreter is a RUNTIME dependency: `shitsuke.kotoba-oracle`
        ;; executes the shipped `resources/shitsuke/oracle/*.kir.edn` through
        ;; it, so `kotoba/hiccup_core.kotoba` is what this library RUNS rather
        ;; than what a test compares against. The one that matters is the
        ;; RAWTEXT breakout predicate: `shitsuke.hiccup` no longer carries a
        ;; second copy of that security rule. The COMPILER stays test-only (see
        ;; :test) — it produced the artifact and never reaches a consumer.
        ;;
        ;; Pinned to the kir the pinned compiler emits for
        ;; (io.github.kotoba-lang/compiler c3be07fb declares kotoba-kir
        ;; 838cd77c). They have to match: KIR is a versioned document, and an
        ;; interpreter reading a shape its emitter did not write is exactly the
        ;; failure the artifact was supposed to remove.
        ;;
        ;; Do NOT advance one without the other, and do not advance either
        ;; casually. Measured 2026-08-12 on a sibling repo: compiler `main`
        ;; (b0095427) returns :bool from `string=?` where this pin returns :i64
        ;; (1/0), so advancing the compiler is a source-level migration of every
        ;; core here plus the parity tests that compare against 1/0 — not a pin
        ;; change. Interpreter-only advancement is worse: it gives an emitter
        ;; and an interpreter that disagree, measured at 1 failure / 32 errors.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "838cd77c55f069336e7da9134c1921d67f98ed92"}}
 :aliases
 {:test  {:extra-paths ["test"]
          ;; kotoba-lang/compiler is TEST-ONLY, for the form-A parity gate that
          ;; compiles kotoba/tokens_core.kotoba + kotoba/hig_core.kotoba and
          ;; requires byte-identical CSS-var emission to shitsuke.tokens /
          ;; shitsuke.hig (ADR-2607270100 §10). The library itself has no
          ;; runtime dependency on it. Dual-render seams stay on the .cljc side.
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       io.github.kotoba-lang/compiler
                       {:git/url "https://github.com/kotoba-lang/compiler.git"
                        ;; inferred option fallback and contextual document keys
                        :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}
          :main-opts ["-m" "cognitect.test-runner"]
          :exec-fn cognitect.test-runner.api/test}
  ;; Regenerate the shipped decision-core KIR. Combine with :test, which is
  ;; where the compiler lives:
  ;;
  ;;   clojure -M:test:gen
  :gen   {:main-opts ["-m" "shitsuke.kotoba-oracle-gen"]}
  ;; Run the delegated RAWTEXT path on ClojureScript/Node. Separate from :test
  ;; because it is not a cljs.test suite — it is the evidence that the
  ;; delegation works on the runtime the JVM suite says nothing about, and that
  ;; the seam fails closed there. See test/shitsuke/cljs_check.cljs.
  :cljs-check {:extra-paths ["test"]
               :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
               :main-opts ["-m" "cljs.main" "-t" "node" "-O" "none"
                           "-o" "target/cljs-check/main.js"
                           "-m" "shitsuke.cljs-check"]}
  ;; real re-frame/reagent for browser builds (consumer :requires shitsuke.re-frame.core)
  :cljs  {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                       reagent/reagent           {:mvn/version "1.2.0"}
                       re-frame/re-frame         {:mvn/version "1.4.3"}}}
  ;; shadow-css class extraction (build-time, same path as slides.build)
  :pages {:extra-deps {com.thheller/shadow-css {:mvn/version "0.6.1"}}}
  ;; local sibling checkout override, same convention as liquid-glass-ui/kotoba-ui's :local alias
  :local {:override-deps {io.github.kotoba-lang/html {:local/root "../html"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
